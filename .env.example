# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on locally (Render sets its own PORT).
PORT=3000

# MongoDB Atlas connection string (free M0 cluster works fine).
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/deegaansan
MONGODB_URI=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Resend (https://resend.com) API key, used to send account verification
# emails. Without it, verification links are just logged to the server
# console instead of emailed — fine for local dev, not for production.
RESEND_API_KEY=

# "From" address for verification emails. Until deegaansan.org is verified
# as a sending domain in Resend, you must use their shared sandbox address
# below, and emails can only be delivered to the Resend account's own email.
MAIL_FROM=Deegansan <onboarding@resend.dev>
